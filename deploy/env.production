#--------------------------------------------------------------------
# IkelyaneMed — Production Environment
# USAGE: cp deploy/env.production .env  puis éditer les valeurs CHANGE_ME
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'https://ikelyanecrm.com/'
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = ikelyanemed_db
database.default.username = ikelyanemed_user
database.default.password = CHANGE_ME_DB_PASSWORD
database.default.DBDriver = MySQLi
database.default.port     = 3306

#--------------------------------------------------------------------
# SESSION (stockée en base de données)
#--------------------------------------------------------------------
session.driver            = 'CodeIgniter\Session\Handlers\DatabaseHandler'
session.cookieName        = imed_session
session.expiration        = 7200
session.savePath          = ci_sessions
session.matchIP           = false
session.timeToUpdate      = 300
session.regenerateDestroy = false

#--------------------------------------------------------------------
# ENCRYPTION
# Générer avec : php spark key:generate  (sur le serveur)
#--------------------------------------------------------------------
encryption.key = hex2bin:CHANGE_ME_32_BYTE_HEX_KEY

#--------------------------------------------------------------------
# EMAIL (SMTP)
# Ces noms correspondent exactement à ce que lit EmailService.php
# via getenv() / env()
#--------------------------------------------------------------------
EMAIL_PROTOCOL  = smtp
SMTP_HOST       = smtp.hostinger.com
SMTP_PORT       = 587
SMTP_CRYPTO     = tls
SMTP_USER       = noreply@ikelyanemed.com
SMTP_PASS       = CHANGE_ME_SMTP_PASSWORD
MAIL_FROM       = noreply@ikelyanemed.com
MAIL_FROM_NAME  = IkelyaneMed

#--------------------------------------------------------------------
# FLUTTERWAVE  (obtenir sur app.flutterwave.com → API Keys)
#--------------------------------------------------------------------
FLW_PUBLIC_KEY     = FLWPUBK-CHANGE_ME
FLW_SECRET_KEY     = FLWSECK-CHANGE_ME
FLW_WEBHOOK_SECRET = CHANGE_ME_WEBHOOK_SECRET
